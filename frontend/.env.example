# Leave blank when the reverse proxy serves the API at the same origin.
VITE_API_BASE_URL=
# Optional staff-only API origin; the staff bell and socket follow this value.
VITE_STAFF_API_URL=
# Optional explicit override. Otherwise derives from the absolute API origin;
# with relative/empty API settings production uses the browser origin.
VITE_STAFF_SOCKET_URL=
VITE_CLINIC_TIME_ZONE=Africa/Khartoum
# Public Google OAuth web client ID for the patient sign-in button.
VITE_GOOGLE_CLIENT_ID=
# Development server only:
VITE_PROXY_TARGET=http://127.0.0.1:5000
