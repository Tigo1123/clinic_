[Unit]
Description=Al-Shifa LAN encrypted backup (installation template)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=clinic-backup
Group=clinic-backup
WorkingDirectory=/opt/clinic-lan
EnvironmentFile=/etc/clinic-lan/backup.env
# The site-approved maintenance wrapper must quiesce application writes, set
# BACKUP_QUIESCE_CONFIRMED=true only while quiesced, run this command, and
# restore service even after failure. Do not activate this example directly.
ExecStart=/usr/bin/docker compose --env-file /etc/clinic-lan/runtime.env -f /opt/clinic-lan/compose.lan.yml --profile backup run --rm backup
