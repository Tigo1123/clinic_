# OFFLINE PHASE 1A.1 TEST-BENCH CONFIGURATION ONLY.
# Copy outside the repository and replace every REPLACE_* placeholder before use.
# Never commit the resulting environment file.

# Runtime, non-secret application settings.
# Phase 1A.1 is HTTP test-bench validation only. Production mode requires a
# canonical HTTPS CORS origin and belongs to a later approved TLS step.
NODE_ENV=development
CLINIC_TIME_ZONE=Africa/Khartoum
CORS_ALLOWED_ORIGINS=http://clinic-server.example.internal:8080
SOCKET_REVOCATION_RECONCILE_MS=10000
SOCKET_REVOCATION_UNHEALTHY_GRACE_MS=15000
JWT_ISSUER=clinic-api
JWT_AUDIENCE=clinic-application
MFA_TOTP_ISSUER=Clinic Management System
VERIFICATION_PROVIDER=disabled
NOTIFICATIONS_DISABLED=true
PHONE_DEFAULT_COUNTRY=SD
DEFAULT_STATE_ID=1
PATIENT_CANCELLATION_CUTOFF_HOURS=2
UPLOAD_MAX_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTRATION_MAX=10
RATE_LIMIT_VERIFICATION_MAX=10
RATE_LIMIT_CLAIM_MAX=10
RATE_LIMIT_ADMIN_RESET_MAX=10
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Optional email runtime settings. Leave empty while VERIFICATION_PROVIDER is
# disabled. If a later approved phase enables email, SMTP_PASS is a secret and
# the remaining names must be configured for the clinic's local mail service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=REPLACE_ONLY_IF_EMAIL_IS_APPROVED
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Al-Shifa Medical Clinic
SMTP_CONNECTION_TIMEOUT_MS=10000

# Long-running runtime secrets. The backend receives only these database URLs;
# both must authenticate as RUNTIME_LOGIN_ROLE. Placeholders are unusable.
POSTGRES_DB=postgres
POSTGRES_USER=clinic_lan_postgres_admin_placeholder
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
DATABASE_URL=postgresql://clinic_lan_app_login_placeholder:REPLACE_WITH_LOCAL_RUNTIME_PASSWORD@postgres:5432/clinic_lan_placeholder
# Must be a direct/session-capable PostgreSQL URL for LISTEN/NOTIFY.
SOCKET_REVOCATION_DATABASE_URL=postgresql://clinic_lan_app_login_placeholder:REPLACE_WITH_LOCAL_RUNTIME_PASSWORD@postgres:5432/clinic_lan_placeholder
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
MEDICAL_ENCRYPTION_KEY=REPLACE_WITH_SEPARATE_RANDOM_MEDICAL_KEY_AT_LEAST_32_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_SEPARATE_RANDOM_MFA_KEY_AT_LEAST_32_CHARACTERS

# Bootstrap/migration-only settings. These are passed only to the explicit
# database-bootstrap profile, never to the long-running backend service.
POSTGRES_ADMIN_CONNECTION=postgresql://clinic_lan_postgres_admin_placeholder:REPLACE_WITH_LOCAL_POSTGRES_PASSWORD@postgres:5432/postgres
LAN_DATABASE_NAME=clinic_lan_placeholder
DATABASE_SCHEMA=public
SCHEMA_OWNER_ROLE=clinic_lan_schema_owner_placeholder
MIGRATION_LOGIN_ROLE=clinic_lan_migration_placeholder
MIGRATION_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_MIGRATION_PASSWORD
MIGRATION_DATABASE_URL=postgresql://clinic_lan_migration_placeholder:REPLACE_WITH_LOCAL_MIGRATION_PASSWORD@postgres:5432/clinic_lan_placeholder
RUNTIME_DATABASE_ROLE=clinic_lan_app_user_placeholder
RUNTIME_LOGIN_ROLE=clinic_lan_app_login_placeholder
RUNTIME_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_RUNTIME_PASSWORD
# Must exactly equal LAN_DATABASE_NAME before bootstrap will make changes.
CONFIRM_LAN_DATABASE_BOOTSTRAP=clinic_lan_placeholder

# Optional, separately invoked reference bootstrap. Use the reviewed migration
# connection; never use the runtime URL or the development seed.
REFERENCE_BOOTSTRAP_DATABASE_URL=postgresql://clinic_lan_migration_placeholder:REPLACE_WITH_LOCAL_MIGRATION_PASSWORD@postgres:5432/clinic_lan_placeholder

# Explicit one-shot backup profile. BACKUP_DATABASE_USER must be a reviewed
# read-only backup login or, temporarily, the migration login; it is never
# passed to the backend. Keep the private decryption key outside this file,
# Git, the application server backup directory, and the backup set.
BACKUP_DATABASE_NAME=clinic_lan_placeholder
BACKUP_DATABASE_USER=clinic_lan_migration_placeholder
BACKUP_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_BACKUP_OR_MIGRATION_PASSWORD
# Set these to the numeric owner/group of BACKUP_OUTPUT_DIR when Docker uses
# user namespaces or rootless mode. The account also needs read access to uploads.
BACKUP_CONTAINER_UID=0
BACKUP_CONTAINER_GID=0
BACKUP_OUTPUT_DIR=./.local/lan-backups
BACKUP_GPG_PUBLIC_KEY_FILE=./deploy/lan/keys/UNCONFIGURED.asc
BACKUP_GPG_RECIPIENT=REPLACE_WITH_FULL_HEXADECIMAL_GPG_FINGERPRINT
BACKUP_GPG_SIGNING_PRIVATE_KEY_FILE=./deploy/lan/keys/UNCONFIGURED-SIGNING-PRIVATE.asc
BACKUP_GPG_SIGNING_FINGERPRINT=REPLACE_WITH_FULL_HEXADECIMAL_SIGNING_FINGERPRINT
# Restore/retention receive only the independently exported signer public key.
BACKUP_GPG_SIGNER_PUBLIC_KEY_FILE=./deploy/lan/keys/UNCONFIGURED-SIGNER-PUBLIC.asc
BACKUP_GPG_SIGNER_FINGERPRINT=REPLACE_WITH_FULL_HEXADECIMAL_SIGNING_FINGERPRINT
BACKUP_QUIESCE_CONFIRMED=false
BACKUP_RETENTION_COUNT=72
BACKUP_RETENTION_DRY_RUN=true
APPLICATION_REVISION=unknown

# Frontend build-time settings. Empty API/socket values mean same-origin.
# compose.lan.yml relies on those application defaults and only passes timezone.
VITE_API_BASE_URL=
VITE_STAFF_API_URL=
VITE_STAFF_SOCKET_URL=
VITE_CLINIC_TIME_ZONE=Africa/Khartoum
