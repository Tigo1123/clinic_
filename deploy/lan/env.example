# OFFLINE PHASE 1A.1 TEST-BENCH CONFIGURATION ONLY.
# Copy outside the repository and replace every REPLACE_* placeholder before use.
# Never commit the resulting environment file.

# Runtime, non-secret application settings.
# Phase 1A.1 is HTTP test-bench validation only. Production mode requires a
# canonical HTTPS CORS origin and belongs to a later approved TLS step.
NODE_ENV=development
CLINIC_TIME_ZONE=Africa/Khartoum
CORS_ALLOWED_ORIGINS=http://clinic-server.example.internal:8080
SOCKET_REVOCATION_RECONCILE_MS=10000
SOCKET_REVOCATION_UNHEALTHY_GRACE_MS=15000
JWT_ISSUER=clinic-api
JWT_AUDIENCE=clinic-application
MFA_TOTP_ISSUER=Clinic Management System
VERIFICATION_PROVIDER=disabled
NOTIFICATIONS_DISABLED=true
PHONE_DEFAULT_COUNTRY=SD
DEFAULT_STATE_ID=1
PATIENT_CANCELLATION_CUTOFF_HOURS=2
UPLOAD_MAX_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTRATION_MAX=10
RATE_LIMIT_VERIFICATION_MAX=10
RATE_LIMIT_CLAIM_MAX=10
RATE_LIMIT_ADMIN_RESET_MAX=10
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Optional email runtime settings. Leave empty while VERIFICATION_PROVIDER is
# disabled. If a later approved phase enables email, SMTP_PASS is a secret and
# the remaining names must be configured for the clinic's local mail service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=REPLACE_ONLY_IF_EMAIL_IS_APPROVED
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Al-Shifa Medical Clinic
SMTP_CONNECTION_TIMEOUT_MS=10000

# Secret runtime settings. Placeholders are deliberately unusable.
POSTGRES_DB=clinic_lan_placeholder
POSTGRES_USER=clinic_lan_placeholder
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
DATABASE_URL=postgresql://clinic_lan_placeholder:REPLACE_WITH_LOCAL_RUNTIME_PASSWORD@postgres:5432/clinic_lan_placeholder
# Must be a direct/session-capable PostgreSQL URL for LISTEN/NOTIFY.
SOCKET_REVOCATION_DATABASE_URL=postgresql://clinic_lan_placeholder:REPLACE_WITH_LOCAL_RUNTIME_PASSWORD@postgres:5432/clinic_lan_placeholder
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
MEDICAL_ENCRYPTION_KEY=REPLACE_WITH_SEPARATE_RANDOM_MEDICAL_KEY_AT_LEAST_32_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_SEPARATE_RANDOM_MFA_KEY_AT_LEAST_32_CHARACTERS

# Migration/bootstrap-only settings. They are documented for a future approved
# bootstrap phase and are not consumed by compose.lan.yml or the running API.
MIGRATION_DATABASE_URL=postgresql://migration_placeholder:REPLACE_WITH_LOCAL_MIGRATION_PASSWORD@postgres:5432/clinic_lan_placeholder
REFERENCE_BOOTSTRAP_DATABASE_URL=postgresql://bootstrap_placeholder:REPLACE_WITH_LOCAL_BOOTSTRAP_PASSWORD@postgres:5432/clinic_lan_placeholder

# Frontend build-time settings. Empty API/socket values mean same-origin.
# compose.lan.yml relies on those application defaults and only passes timezone.
VITE_API_BASE_URL=
VITE_STAFF_API_URL=
VITE_STAFF_SOCKET_URL=
VITE_CLINIC_TIME_ZONE=Africa/Khartoum
