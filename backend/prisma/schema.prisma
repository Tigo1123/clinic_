datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id                         String                  @id @default(uuid())
  username                   String                  @unique
  passwordHash               String
  role                       String // ADMIN, RECEPTIONIST, DOCTOR, PHARMACIST, LAB_TECH
  status                     String                  @default("ACTIVE") // ACTIVE, INACTIVE
  lastPasswordChange         DateTime?
  authVersion                Int                     @default(0)
  mfaSecret                  String?
  mfaEnabled                 Boolean                 @default(false)
  mfaConfiguration           MfaConfiguration?
  mfaRecoveryCodes           MfaRecoveryCode[]
  mfaChallenges              MfaChallenge[]
  preferredLanguage          String                  @default("ar") // ar, en
  createdAt                  DateTime                @default(now())
  doctor                     Doctor?
  email                      String?                 @unique
  phoneNormalized            String?                 @unique
  emailVerifiedAt            DateTime?
  phoneVerifiedAt            DateTime?
  patient                    Patient?
  verificationChallenges     VerificationChallenge[]
  issuedClaimCodes           PatientClaimCode[]      @relation("ClaimCodeIssuer")
  pendingPatientRegistration PatientRegistration?
  processedRefunds           Refund[]                @relation("RefundOperator")
  stockMovements             StockMovement[]         @relation("StockMovementActor")
}

model State {
  id       Int       @id
  labelAr  String
  labelEn  String
  patients Patient[]
}

model Doctor {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullNameAr      String
  fullNameEn      String
  specialtyAr     String
  specialtyEn     String
  consultationFee Decimal
  weeklySchedule  String // JSON config of slots & hours
  status          String          @default("ACTIVE") // ACTIVE, INACTIVE
  updatedAt       DateTime        @updatedAt
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
}

model Patient {
  id                       String             @id @default(uuid())
  fileNumber               String             @unique @default(dbgenerated("('SHF-'::text || lpad(nextval('patient_file_number_seq'::regclass)::text, 6, '0'::text))"))
  fullNameAr               String
  fullNameEn               String
  gender                   String // MALE, FEMALE
  dateOfBirth              String // YYYY-MM-DD
  nationalId               String?            @unique
  phone                    String
  bloodType                String?
  addressStateId           Int
  addressState             State              @relation(fields: [addressStateId], references: [id])
  addressDetails           String?
  emergencyContact         String
  status                   String             @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt                DateTime           @default(now())
  nationalIdAttachmentPath String?
  insuranceAttachmentPath  String?
  appointments             Appointment[]
  medicalRecords           MedicalRecord[]
  consents                 Consent[]
  prescriptions            Prescription[]
  labOrders                LabOrder[]
  invoices                 Invoice[]
  insuranceClaims          InsuranceClaim[]
  userId                   String?            @unique
  user                     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  claimCodes               PatientClaimCode[]

  @@index([phone])
}

model Appointment {
  id                String             @id @default(uuid())
  patientId         String
  patient           Patient            @relation(fields: [patientId], references: [id])
  doctorId          String
  doctor            Doctor             @relation(fields: [doctorId], references: [id])
  appointmentDate   String // YYYY-MM-DD
  appointmentTime   String // HH:MM
  status            String             @default("SCHEDULED") // SCHEDULED, CHECKED_IN, IN_CONSULTATION, COMPLETED, CANCELLED, NO_SHOW
  createdAt         DateTime           @default(now())
  medicalRecord     MedicalRecord?
  emergencyOverride EmergencyOverride?
  invoices          Invoice[]

  @@index([appointmentDate, appointmentTime])
  @@index([doctorId, appointmentDate, appointmentTime])
}

model EmergencyOverride {
  id             String      @id @default(uuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  justification  String
  authorizedById String
  timestamp      DateTime    @default(now())
}

model MedicalRecord {
  id                     String         @id @default(uuid())
  patientId              String
  patient                Patient        @relation(fields: [patientId], references: [id])
  doctorId               String
  doctor                 Doctor         @relation(fields: [doctorId], references: [id])
  appointmentId          String         @unique
  appointment            Appointment    @relation(fields: [appointmentId], references: [id])
  visitDate              DateTime       @default(now())
  symptomsEncrypted      String
  diagnosisEncrypted     String
  treatmentEncrypted     String
  vitalSignsJson         String // JSON keys: blood_pressure, heart_rate, temperature, weight
  clinicalNotesEncrypted String
  attachmentPath         String?
  prescriptions          Prescription[]
  labOrders              LabOrder[]
}

model Consent {
  id                 String   @id @default(uuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id])
  consentType        String // EMR_ACCESS, TREATMENT, PROCEDURE
  signatureSvg       String?
  otpVerified        Boolean  @default(false)
  guardianName       String?
  guardianNationalId String?
  timestamp          DateTime @default(now())
}

model Prescription {
  id               String           @id @default(uuid())
  medicalRecordId  String
  medicalRecord    MedicalRecord    @relation(fields: [medicalRecordId], references: [id])
  patientId        String
  patient          Patient          @relation(fields: [patientId], references: [id])
  doctorId         String
  doctor           Doctor           @relation(fields: [doctorId], references: [id])
  prescriptionDate DateTime         @default(now())
  status           String           @default("ACTIVE") // ACTIVE, FILLED, PARTIALLY_FILLED, CANCELLED
  prescribedDrugs  PrescribedDrug[]
  invoices         Invoice[]
}

model DrugFormulary {
  id               String           @id @default(uuid())
  brandName        String
  labelAr          String
  labelEn          String
  genericName      String
  strength         String
  dosageForm       String
  identityKey      String           @unique
  unitPriceSdg     Decimal?
  status           String           @default("INACTIVE") // ACTIVE, INACTIVE
  updatedAt        DateTime         @updatedAt
  prescribedDrugs  PrescribedDrug[]
  inventoryBatches InventoryBatch[]
  stockMovements   StockMovement[]
}

model PrescribedDrug {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  // Formulary medication: linked to clinic inventory.
  drugId String?
  drug   DrugFormulary? @relation(fields: [drugId], references: [id])

  // Free-text medication prescribed by the doctor.
  // These medicines are not automatically connected to clinic inventory.
  customDrugName String?

  dosage         String
  duration       String
  instructionsAr String
  instructionsEn String
  qtyPrescribed  Int
  qtyDispensed   Int    @default(0)
  ledgerVersion  Int    @default(0)

  // Pharmacy review is required when a doctor enters a free-text medicine.
  // NOT_REQUIRED: existing formulary medicine
  // PENDING_REVIEW: custom medicine waiting for pharmacy
  // APPROVED: pharmacist linked/created an approved formulary medicine
  // EXTERNAL: medicine will be purchased outside the clinic
  pharmacyReviewStatus String    @default("NOT_REQUIRED")
  pharmacyReviewedAt   DateTime?
  pharmacyReviewNote   String?

  @@index([pharmacyReviewStatus])
}

model InventoryBatch {
  id                    String          @id @default(uuid())
  drugId                String
  drug                  DrugFormulary   @relation(fields: [drugId], references: [id])
  batchNumber           String
  normalizedBatchNumber String
  expiryDate            String // YYYY-MM-DD
  qtyOnHand             Int
  minReorderLevel       Int             @default(10)
  ledgerVersion         Int             @default(0)
  stockMovements        StockMovement[]

  @@unique([drugId, normalizedBatchNumber, expiryDate])
  @@index([expiryDate])
}

model StockMovement {
  id               String         @id @default(uuid())
  drugId           String
  drug             DrugFormulary  @relation(fields: [drugId], references: [id], onDelete: Restrict)
  inventoryBatchId String
  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  movementType     String
  quantityDelta    Int
  resultingBalance Int
  actorUserId      String?
  actor            User?          @relation("StockMovementActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  referenceType    String?
  referenceId      String?
  reason           String?
  idempotencyKey   String?        @unique
  createdAt        DateTime       @default(now())

  @@index([drugId, createdAt])
  @@index([inventoryBatchId, createdAt])
  @@index([actorUserId, createdAt])
}

model ClinicalService {
  id            String         @id @default(uuid())
  labelAr       String
  labelEn       String
  baseFeeSdg    Decimal?
  baseFeeUsd    Decimal?
  category      String // CONSULTATION, LABORATORY, RADIOLOGY, CLINICAL_PROCEDURE
  status        String         @default("ACTIVE") // ACTIVE, INACTIVE
  updatedAt     DateTime       @updatedAt
  labOrderItems LabOrderItem[]
}

model LabOrder {
  id                  String         @id @default(uuid())
  medicalRecordId     String
  medicalRecord       MedicalRecord  @relation(fields: [medicalRecordId], references: [id])
  patientId           String
  patient             Patient        @relation(fields: [patientId], references: [id])
  doctorId            String
  doctor              Doctor         @relation(fields: [doctorId], references: [id])
  orderDate           DateTime       @default(now())
  status              String         @default("PENDING_BILLING") // PENDING_BILLING, PAID, SAMPLE_COLLECTED, COMPLETED
  items               LabOrderItem[]
  invoices            Invoice[]
  releasedToPatientAt DateTime?
}

model VerificationChallenge {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String
  targetNormalized String
  codeHash         String
  expiresAt        DateTime
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(5)
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, type, createdAt])
}

model MfaConfiguration {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted     String
  state               String    @default("PENDING") // PENDING, ACTIVE
  enrollmentExpiresAt DateTime?
  lastTotpStep        BigInt?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model MfaChallenge {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      String    @default("LOGIN")
  authVersion  Int?
  tokenHash    String    @unique
  expiresAt    DateTime
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

model PatientClaimCode {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdBy   User      @relation("ClaimCodeIssuer", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([patientId, createdAt])
}

model PatientRegistration {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullNameAr     String
  fullNameEn     String
  gender         String
  dateOfBirth    String
  addressStateId Int
  createdAt      DateTime @default(now())
}

model LabOrderItem {
  id         String   @id @default(uuid())
  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  // Standard test selected from the clinic catalogue.
  serviceId String?
  service   ClinicalService? @relation(fields: [serviceId], references: [id])

  // Free-text test requested by the doctor when it is not in the catalogue.
  customTestName String?

  // Lab review is required when a doctor enters a free-text test.
  // NOT_REQUIRED: existing catalogue service
  // PENDING_REVIEW: custom test waiting for laboratory review
  // APPROVED: linked to an approved catalogue service
  // EXTERNAL: test is not provided by this clinic and is not billable
  labReviewStatus String    @default("NOT_REQUIRED")
  labReviewedAt   DateTime?
  labReviewNote   String?

  resultValue        String?
  referenceRangeMin  Decimal?
  referenceRangeMax  Decimal?
  isOutOfRange       Boolean  @default(false)
  fileAttachmentPath String?
  resultVersion      Int      @default(0)

  @@index([labReviewStatus])
}

model Invoice {
  id                  String             @id @default(uuid())
  patientId           String
  patient             Patient            @relation(fields: [patientId], references: [id])
  appointmentId       String?
  appointment         Appointment?       @relation(fields: [appointmentId], references: [id])
  labOrderId          String?
  labOrder            LabOrder?          @relation(fields: [labOrderId], references: [id], onDelete: SetNull)
  prescriptionId      String?
  prescription        Prescription?      @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  invoiceDate         DateTime           @default(now())
  totalAmountSdg      Decimal
  totalAmountUsd      Decimal
  invoiceExchangeRate Decimal
  paymentStatus       String             @default("UNPAID") // UNPAID, PAID, PARTIALLY_PAID, PARTIALLY_REFUNDED, REFUNDED
  invoiceType         String             @default("GENERAL") // GENERAL, CONSULTATION, LABORATORY, PHARMACY
  ledgerVersion       Int                @default(0)
  insuranceClaimId    String?            @unique
  insuranceClaim      InsuranceClaim?    @relation(fields: [insuranceClaimId], references: [id])
  createdBy           String // User UUID
  items               InvoiceItem[]
  payments            Payment[]
  paymentOperations   PaymentOperation[]
  refunds             Refund[]

  @@index([invoiceDate])
  @@index([appointmentId, invoiceType, paymentStatus])
  @@index([labOrderId, invoiceType, paymentStatus])
  @@index([prescriptionId, invoiceType, paymentStatus])
}

model InvoiceItem {
  id            String  @id @default(uuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  descriptionAr String
  descriptionEn String
  qty           Int     @default(1)
  unitPriceSdg  Decimal
  unitPriceUsd  Decimal
}

model Payment {
  id                   String            @id @default(uuid())
  invoiceId            String
  invoice              Invoice           @relation(fields: [invoiceId], references: [id])
  amountSdg            Decimal
  amountUsd            Decimal
  paymentMethod        String // CASH, CARD, BANKAK, FAWRY
  transactionReference String?           @unique
  verificationStatus   String            @default("VERIFIED") // PENDING_MANUAL, VERIFIED, REJECTED
  receivedBy           String // User UUID
  createdAt            DateTime          @default(now())
  paymentOperationId   String?
  paymentOperation     PaymentOperation? @relation(fields: [paymentOperationId], references: [id])

  @@index([paymentOperationId])
}

model PaymentOperation {
  id             String    @id @default(uuid())
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])
  idempotencyKey String    @unique
  requestHash    String
  receivedBy     String
  payments       Payment[]
  createdAt      DateTime  @default(now())

  @@index([invoiceId, createdAt])
}

model Refund {
  id                   String   @id @default(uuid())
  invoiceId            String
  invoice              Invoice  @relation(fields: [invoiceId], references: [id])
  amountSdg            Decimal
  amountUsd            Decimal
  refundMethod         String // CASH, CARD, BANKAK, FAWRY
  transactionReference String?  @unique
  reason               String?
  processedBy          String
  operator             User     @relation("RefundOperator", fields: [processedBy], references: [id])
  createdAt            DateTime @default(now())

  @@index([invoiceId, createdAt])
}

model InsuranceCompany {
  id               String           @id @default(uuid())
  labelAr          String
  labelEn          String
  copayPercentage  Decimal
  billingCycleDays Int              @default(30)
  claims           InsuranceClaim[]
}

model InsuranceClaim {
  id                 String           @id @default(uuid())
  insuranceCompanyId String
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id])
  invoiceId          String           @unique
  invoice            Invoice?
  claimAmountSdg     Decimal
  claimStatus        String           @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, PAID
  submissionDate     DateTime?
  paymentDate        DateTime?
}

model NotificationLog {
  id             String    @id @default(uuid())
  recipientPhone String
  messageType    String // BOOKING_CONFIRM, CANCELLATION, REMINDER, RESULTS_READY
  messageBody    String
  language       String    @default("ar") // ar, en
  status         String    @default("QUEUED") // QUEUED, SENT, DELIVERED, FAILED
  retryCount     Int       @default(0)
  lastAttempt    DateTime?
  createdAt      DateTime  @default(now())
}

model TenantAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String
  ipAddress String
  timestamp DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
