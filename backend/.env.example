NODE_ENV=development
CLINIC_TIME_ZONE=Africa/Khartoum
PORT=5000
DATABASE_URL=file:./dev.db
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret
MEDICAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-medical-encryption-key
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
VERIFICATION_PROVIDER=development
PHONE_DEFAULT_COUNTRY=RW
DEFAULT_STATE_ID=1
PATIENT_CANCELLATION_CUTOFF_HOURS=2
NOTIFICATIONS_DISABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
# SMS delivery is not implemented. No SMS credentials are currently supported.
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTRATION_MAX=10
RATE_LIMIT_VERIFICATION_MAX=10
RATE_LIMIT_CLAIM_MAX=10
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
