{
  "name": "clinic-backend",
  "version": "1.0.0",
  "description": "Clinic Management System Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS=\"--no-network-family-autoselection --dns-result-order=ipv4first\" node src/server.js",
    "start:container": "NODE_OPTIONS=\"--no-network-family-autoselection --dns-result-order=ipv4first\" node src/server.js",
    "dev": "NODE_OPTIONS=\"--no-network-family-autoselection --dns-result-order=ipv4first\" nodemon src/server.js",
    "build:nest": "nest build",
    "start:nest": "node dist/main.js",
    "dev:nest": "nest start --watch",
    "db:init": "prisma migrate dev --name init",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:grant:patient-mrn-sequence": "sh scripts/provision-patient-mrn-sequence.sh",
    "db:seed": "node prisma/seed.js",
    "admin:reset-password": "node scripts/reset-admin-password.js",
    "seed:staging": "node scripts/seed-staging.js",
    "qa:reset": "node scripts/reset-qa-db.js",
    "qa:workflow": "node scripts/qa-workflow.js",
    "qa:visual-fixtures": "node scripts/seed-qa-visual-states.js",
    "test": "node test/run-tests.js",
    "backup:postgres": "sh scripts/backup-postgres.sh",
    "bootstrap:reference": "node scripts/bootstrap-reference-data.js",
    "start:staging": "node src/server.js",
    "start:staging:migrate": "prisma migrate deploy && npm run start:staging",
    "test:schedule-workflow": "node scripts/test-schedule-workflow.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.10",
    "luxon": "^3.7.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.1",
    "otpauth": "^9.4.1",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.4",
    "rimraf": "^6.1.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
